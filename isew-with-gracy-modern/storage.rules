rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function admin() { return request.auth != null && request.auth.token.admin == true && request.auth.token.email_verified == true; }
  match /{folder}/{file} {
   allow read: if folder in ['classes','testimonials','journal'];
   allow create, update: if admin() && folder in ['classes','testimonials','journal']
    && request.resource.size < 5 * 1024 * 1024
    && request.resource.contentType.matches('image/(jpeg|png|webp)')
    && file.matches('^[a-zA-Z0-9_-]+\\.(jpg|jpeg|png|webp)$');
   allow delete: if admin() && folder in ['classes','testimonials','journal'];
  }
  match /{allPaths=**} { allow read, write: if false; }
 }
}
